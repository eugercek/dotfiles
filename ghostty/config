font-family = JetBrainsMono Nerd Font
font-size = 20
cursor-invert-fg-bg = true

command = /opt/homebrew/bin/tmux new-session -A -s main

clipboard-paste-protection = false

# Distribute leftover grid padding evenly instead of dumping it on right/bottom,
# and remove the fixed edge padding entirely.
window-padding-balance = true
window-padding-x = 0
window-padding-y = 0

macos-option-as-alt = true
macos-titlebar-style = "hidden"
macos-titlebar-proxy-icon = "hidden"

keybind = global:option+space=toggle_quick_terminal
quick-terminal-position = right
quick-terminal-size = 40%
quick-terminal-screen = main

theme = light:Builtin Light,dark:Gruvbox Dark Hard

# Send tmux prefix (C-b) to tmux
# These are all the keybindings I use in tmux
# If a keybinding is not here I may still use it via C-b 
# But if it's frequent enough it should be here

# Navigate between panes also smart-splits.nvim
keybind = super+h=text:\x02h
keybind = super+j=text:\x02j
keybind = super+k=text:\x02k
keybind = super+l=text:\x02l

# Resize panes easily
keybind = super+shift+h=text:\x02H
keybind = super+shift+j=text:\x02J
keybind = super+shift+k=text:\x02K
keybind = super+shift+l=text:\x02L

# Window Operations
keybind = super+t=text:\x02c
keybind = super+shift+w=text:\x02&
keybind = super+n=text:\x02n
keybind = super+p=text:\x02p
keybind = super+shift+n=text:\x02N
keybind = super+shift+p=text:\x02P
keybind = super+,=text:\x02,

# Go to window N
keybind = super+digit_1=text:\x021
keybind = super+digit_2=text:\x022
keybind = super+digit_3=text:\x023
keybind = super+digit_4=text:\x024
keybind = super+digit_5=text:\x025
keybind = super+digit_6=text:\x026
keybind = super+digit_7=text:\x027
keybind = super+digit_8=text:\x028
keybind = super+digit_9=text:\x029

# zoom
keybind = super+z=text:\x02z
# choose session
keybind = super+shift+s=text:\x02S
# enter copy mode
keybind = super+g=text:\x02[

keybind = super+w=text:\x02x
keybind = super+enter=text:\x02v
keybind = super+s=text:\x02s
keybind = super+shift+t=text:\x02t

keybind = super+e=text:\x02E

# move pane to window (blank target in the prompt breaks it out to a new window)
keybind = super+m=text:\x02m

# Mac-style word/line delete (Ctrl-W / Ctrl-U work in nvim, zsh, claude, etc.)
keybind = alt+backspace=text:\x17
keybind = super+backspace=text:\x15

# Using these in shell:
# - meta+f: forward word
# - meta+d: delete word
keybind = super+f=unbind
keybind = super+d=unbind

# Session management (super+r picks a session; rename via ctrl-b R)
keybind = super+r=text:\x02g
