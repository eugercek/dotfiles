{
  "Code Fence": {
    "prefix": "<c",
    "body": [
      "```$1",
      "$0",
      "```"
    ],
    "description": "Markdown code fence"
  },
  "C Code Fence": {
    "prefix": "<cc",
    "body": [
      "```C",
      "$0",
      "```"
    ],
    "description": "Markdown C code fence"
  },
  "SQL Code Fence": {
    "prefix": "<cs",
    "body": [
      "```sql",
      "$0",
      "```"
    ],
    "description": "Markdown SQL code fence"
  },
  "Task Item": {
    "prefix": "<t",
    "body": [
      "- [ ] ${1:task}$0"
    ],
    "description": "Markdown task list item"
  },
  "Frontmatter": {
    "prefix": "<front",
    "body": [
      "---",
      "tags: [${2:tag}]",
      "---",
      "",
      "$0"
    ],
    "description": "YAML frontmatter block"
  },
  "Callout": {
    "prefix": "<note",
    "body": [
      "> [!NOTE]",
      "> ${1:content}",
      "> $0"
    ],
    "description": "Markdown note callout"
  }
}
